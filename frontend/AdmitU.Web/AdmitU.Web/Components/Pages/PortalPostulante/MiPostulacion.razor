@page "/postulante/mi-postulacion"
@inject ToastService Avisos

<PageTitle>Mi postulación · AdmitU</PageTitle>

@if (p is null)
{
    <PageHeader Titulo="Mi postulación" Migas="@(["Mi postulación"])" />
    <section class="card"><EmptyState Icono="file-text" Titulo="Aún no tienes una postulación" Mensaje="Elige tu carrera y modalidad para comenzar.">
        <a class="btn btn-primary" style="margin-top:14px" href="/postulante/postular"><Icon Name="plus" Size="16" />Iniciar postulación</a>
    </EmptyState></section>
}
else
{
    <PageHeader Titulo="@p.Codigo" Subtitulo="@($"{DatosDemo.Carrera(p.CarreraId)?.Nombre} · {DatosDemo.Convocatoria(p.ConvocatoriaId)?.Nombre}")" Migas="@(["Mi postulación"])">
        <Acciones>
            <button type="button" class="btn btn-ghost" @onclick='() => Avisos.Exito("Constancia descargada")'><Icon Name="download" Size="16" />Descargar constancia</button>
        </Acciones>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(p.Observacion))
    {
        <div class="notice" style="margin-bottom:18px" role="alert">
            <Icon Name="alert" Size="20" />
            <div><strong>Necesitamos que corrijas tu postulación</strong><p>@p.Observacion</p></div>
        </div>
    }

    <div class="detail-grid">
        <div class="stack">
            <section class="card card-pad">
                <div class="card-head"><h2>Estado de mi postulación</h2><StatusBadge Texto="@p.Estado.Etiqueta()" Tono="@p.Estado.Tono()" /></div>
                <ProgresoPostulacion Postulacion="p" />
            </section>

            <section class="card card-pad">
                <div class="card-head"><div><h2>Mis documentos</h2><p>Reemplaza los documentos observados para continuar.</p></div></div>
                <ul class="list-rows">
                    @foreach (var d in documentos)
                    {
                        <li style="align-items:flex-start;flex-wrap:wrap">
                            <span class="file-icon">@d.Tipo</span>
                            <div class="file-meta"><strong>@d.Requisito</strong><small>@d.Archivo · @Formato.Tamanio(d.TamanioKb) · cargado el @Formato.Fecha(d.FechaCarga)</small></div>
                            <StatusBadge Texto="@d.Estado.Etiqueta()" Tono="@d.Estado.Tono()" />
                            @if (d.Estado == EstadoDocumento.Observado)
                            {
                                <div style="flex-basis:100%;display:grid;gap:10px;padding-left:54px">
                                    @if (!string.IsNullOrWhiteSpace(d.Comentario)) { <p class="hint">Observación: @d.Comentario</p> }
                                    <ZonaCarga Etiqueta="Subir nueva versión" OnArchivo="ArchivoCargado" />
                                </div>
                            }
                        </li>
                    }
                </ul>
            </section>

            <section class="card card-pad">
                <div class="card-head"><div><h2>Historial de estados</h2><p>Los cambios de tu postulación.</p></div></div>
                <HistorialEstados PostulacionId="p.Id" />
            </section>
        </div>

        <aside class="stack">
            <section class="card card-pad">
                <div class="card-head"><h2>Pago de inscripción</h2></div>
                @if (pago is null)
                {
                    <p class="muted">Se generará al enviar tu postulación.</p>
                }
                else
                {
                    <div class="summary-rows">
                        <div><span>Código</span><strong class="mono">@pago.Codigo</strong></div>
                        <div><span>Monto</span><strong>@Formato.Soles(pago.Monto)</strong></div>
                        <div><span>Medio</span><strong>@pago.Medio</strong></div>
                        <div><span>Estado</span><StatusBadge Texto="@pago.Estado.Etiqueta()" Tono="@pago.Estado.Tono()" /></div>
                    </div>
                    @if (pago.Estado == EstadoPago.Pendiente)
                    {
                        <a class="btn btn-primary" style="width:100%;margin-top:18px" href="/postulante/pago"><Icon Name="upload" Size="16" />Ir a Mi pago</a>
                    }
                }
            </section>

            <section class="card card-pad">
                <div class="card-head"><h2>Resumen</h2></div>
                <div class="summary-rows">
                    <div><span>Carrera</span><strong>@DatosDemo.Carrera(p.CarreraId)?.Nombre</strong></div>
                    <div><span>Facultad</span><strong>@DatosDemo.Facultad(DatosDemo.Carrera(p.CarreraId)?.FacultadId ?? 0)?.Nombre</strong></div>
                    <div><span>Modalidad</span><strong>@DatosDemo.Modalidad(p.ModalidadId)?.Nombre</strong></div>
                    <div><span>Sede de evaluación</span><strong>@DatosDemo.Sede(p.SedeId)?.Nombre</strong></div>
                    <div><span>Enviada</span><strong>@Formato.Fecha(p.FechaEnvio)</strong></div>
                </div>
            </section>
        </aside>
    </div>
}

@code {
    private void ArchivoCargado(string nombre) => Avisos.Exito("Documento cargado: " + nombre);

    private Postulacion? p;
    private Pago? pago;
    private List<Documento> documentos = [];

    protected override void OnInitialized()
    {
        p = DatosDemo.Postulaciones.FirstOrDefault(x => x.PostulanteId == DatosDemo.PostulanteActualId);
        if (p is null) return;
        pago = DatosDemo.Pagos.FirstOrDefault(x => x.PostulacionId == p.Id);
        documentos = DatosDemo.Documentos.Where(x => x.PostulacionId == p.Id).ToList();
    }
}
