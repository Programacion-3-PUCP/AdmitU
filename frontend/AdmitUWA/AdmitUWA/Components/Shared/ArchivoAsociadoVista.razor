@using System.Net
@using AdmitUWA.Services.REST
@inject AdmitURestClient Api

<button type="button" class="btn btn-ghost btn-sm" disabled="@ocupado" @onclick="Mostrar">
    @(ocupado ? "Cargando…" : "Ver archivo")
</button>
@if (error is not null)
{
    <p class="validation-message" role="status">@error</p>
}
<Drawer Abierto="@(uri is not null)" Titulo="Archivo del expediente" OnCerrar="() => uri = null">
    @if (uri is not null)
    {
        <div class="drawer-body">
            <div><a class="btn btn-ghost btn-sm" href="@uri" download="@nombre">Descargar @nombre</a></div>
            @if (mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
            {
                <div style="padding:12px;border:1px solid var(--border);border-radius:10px;background:var(--surface-2);text-align:center">
                    <img src="@uri" alt="Archivo @nombre" style="max-width:100%;max-height:560px;object-fit:contain;border-radius:6px" />
                </div>
            }
            else
            {
                <iframe src="@uri" title="Archivo @nombre" style="width:100%;height:600px;border:1px solid var(--border);border-radius:10px"></iframe>
            }
        </div>
    }
</Drawer>

@code {
    [Parameter] public int PostulanteId { get; set; }
    [Parameter] public string Tipo { get; set; } = "DOCUMENTO";
    [Parameter] public int ReferenciaId { get; set; }

    private bool ocupado;
    private string? uri;
    private string? error;
    private string? nombre;
    private string mime = "application/pdf";
    private (int, string, int) anterior;

    protected override void OnParametersSet()
    {
        var actual = (PostulanteId, Tipo, ReferenciaId);
        if (actual != anterior)
        {
            anterior = actual;
            uri = null;
            error = null;
        }
    }

    private async Task Mostrar()
    {
        if (ocupado) return;
        ocupado = true;
        error = null;
        try
        {
            var list = await Api.ListarArchivosAsync(PostulanteId);
            var a = list.FirstOrDefault(x => x.Tipo == Tipo && x.ReferenciaId == ReferenciaId);
            if (a is null)
            {
                error = "Este registro histórico no contiene un archivo durable asociado.";
                return;
            }
            var bytes = await Api.DescargarArchivoAsync(a.Id);
            nombre = a.Nombre;
            mime = a.Mime;
            uri = "data:" + a.Mime + ";base64," + Convert.ToBase64String(bytes);
        }
        catch (HttpRequestException ex)
        {
            error = ex.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "Tu sesión expiró. Vuelve a iniciar sesión.",
                HttpStatusCode.Forbidden => "No cuentas con permisos para consultar los archivos de este expediente.",
                HttpStatusCode.NotFound => "El archivo ya no se encuentra disponible.",
                _ => "No se pudo recuperar el archivo desde el servidor."
            };
        }
        catch (Exception)
        {
            error = "No se pudo recuperar el archivo. Verifica tu sesión y permisos.";
        }
        finally
        {
            ocupado = false;
        }
    }
}
