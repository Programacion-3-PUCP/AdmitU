@page "/evaluador/reportes/observados"
@inject DatosSesion Datos

<PageTitle>Reporte de observados · AdmitU</PageTitle>

<PageHeader Titulo="Reporte de expedientes observados" Subtitulo="Observaciones registradas por tipo y su estado de subsanación." Migas="@(["Reportes", "Observados"])" />

<ReporteParametros EtiquetaDesde="Observados desde" OnAplicar="Generar" />

<section class="card card-pad" style="margin-top:18px">
    <div class="card-head"><div><h2>Resumen por tipo</h2><p>Emitido el @Formato.FechaHora(DateTime.Now)</p></div><div class="report-total"><span>Total</span><strong>@filas.Count</strong></div></div>
    @if (filas.Count == 0)
    {
        <EmptyState Icono="check-circle" Titulo="Sin observaciones" Mensaje="No hay documentos observados con los parámetros elegidos." />
    }
    else
    {
        <div class="table-scroll">
            <table class="table report-table">
                <thead><tr><th>Tipo de observación</th><th class="num">Total</th><th class="num">Por subsanar</th><th class="num">Subsanadas</th><th>Proporción</th></tr></thead>
                <tbody>
                    @foreach (var g in filas.GroupBy(f => f.Tipo).OrderByDescending(g => g.Count()))
                    {
                        <tr>
                            <td>@g.Key.Etiqueta()</td>
                            <td class="num">@g.Count()</td>
                            <td class="num">@g.Count(f => f.Estado == EstadoObservacion.Abierta)</td>
                            <td class="num">@g.Count(f => f.Estado == EstadoObservacion.Subsanada)</td>
                            <td><span class="mini-bar"><i style="width:@(g.Count() * 100 / filas.Count)%"></i></span>@Formato.Porcentaje(g.Count(), filas.Count)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@if (filas.Count > 0)
{
    <section class="card card-pad" style="margin-top:18px">
        <div class="card-head"><h2>Detalle</h2></div>
        <div class="table-scroll">
            <table class="table">
                <thead><tr><th>Fecha</th><th>Postulación</th><th>Documento</th><th>Tipo</th><th>Descripción</th><th>Estado</th></tr></thead>
                <tbody>
                    @foreach (var o in filas)
                    {
                        var p = Datos.Postulacion(Datos.Documento(o.DocumentoId)?.PostulacionId ?? 0);
                        <tr>
                            <td>@Formato.Fecha(o.Fecha)</td>
                            <td><span class="mono">@p?.Codigo</span><span class="cell-sub">@Datos.PersonaDe(p)?.NombreCompleto</span></td>
                            <td>@Datos.Documento(o.DocumentoId)?.Requisito</td>
                            <td>@o.Tipo.Etiqueta()</td>
                            <td class="wrap">@o.Descripcion</td>
                            <td><StatusBadge Texto="@o.Estado.Etiqueta()" Tono="@o.Estado.Tono()" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private List<Observacion> filas = [];

    private void Generar(ReporteParametros.Filtro f)
    {
        filas = Datos.Observaciones.Where(o =>
        {
            var p = Datos.Postulacion(Datos.Documento(o.DocumentoId)?.PostulacionId ?? 0);
            return p is not null
                && (f.ConvocatoriaId == 0 || p.ConvocatoriaId == f.ConvocatoriaId)
                && (f.ModalidadId == 0 || p.ModalidadId == f.ModalidadId)
                && (f.Desde is null && f.Hasta is null || f.EnRango(o.Fecha));
        }).OrderByDescending(o => o.Fecha).ToList();
    }
}
