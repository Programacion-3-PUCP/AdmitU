@page "/postulante/antecedentes"
@using AdmitUWA.Services.REST
@inject AdmitURestClient Api
@inject DatosSesion Datos
@inject ToastService Avisos

<PageTitle>Antecedentes académicos · AdmitU</PageTitle>
<PageHeader Titulo="Antecedentes académicos" Subtitulo="Carga y actualiza tus certificados académicos en PDF." Migas="@(["Antecedentes académicos"])" />

@if (error is not null)
{
    <p class="validation-message" role="alert">@error</p>
}

<section class="card card-pad stack" style="margin-bottom:18px">
    <h2>@(editando == 0 ? "Agregar certificado" : "Modificar certificado")</h2>
    <div class="form-grid">
        <div class="field">
            <label for="cert-tipo">Tipo de institución</label>
            <select id="cert-tipo" @bind="tipoInstitucion" disabled="@ocupado">
                <option value="COLEGIO">Colegio</option>
                <option value="UNIVERSIDAD">Universidad</option>
            </select>
        </div>
        <div class="field">
            <label for="cert-inst">Institución <span class="req">*</span></label>
            <input id="cert-inst" @bind="institucion" @bind:event="oninput" maxlength="150" disabled="@ocupado" placeholder="Ej. Colegio Nuestra Señora de Guadalupe" />
        </div>
        <div class="field">
            <label for="cert-inicio">Año de inicio</label>
            <input id="cert-inicio" type="number" @bind="inicio" min="1900" max="@Datos.Hoy.Year" disabled="@ocupado" />
        </div>
        <div class="field">
            <label for="cert-fin">Año de finalización</label>
            <input id="cert-fin" type="number" @bind="fin" min="1900" max="@Datos.Hoy.Year" disabled="@ocupado" />
        </div>
        <div class="field">
            <label for="cert-fecha">Fecha de registro</label>
            <input id="cert-fecha" type="date" @bind="fecha" max="@Datos.Hoy.ToString("yyyy-MM-dd")" disabled="@ocupado" />
        </div>
    </div>
    <ZonaCarga Etiqueta="Adjuntar certificado PDF" Formato="FormatoArchivo.Pdf" Deshabilitado="@ocupado"
               Valor="@(seleccion?.Nombre)" OnContenido="f => seleccion = f" />
    <div class="row-actions" style="justify-content:flex-start">
        <button type="button" class="btn btn-primary" disabled="@(ocupado || seleccion is null || string.IsNullOrWhiteSpace(institucion))" @onclick="Guardar">Guardar certificado</button>
        @if (editando > 0)
        {
            <button type="button" class="btn btn-ghost" disabled="@ocupado" @onclick="Cancelar">Cancelar edición</button>
        }
    </div>
</section>

@foreach (var a in archivos.Where(x => x.Tipo == "CERTIFICADO"))
{
    var metadata = Datos.Antecedentes.FirstOrDefault(x => x.Id == a.ReferenciaId);
    var nombreInst = !string.IsNullOrWhiteSpace(a.Institucion) ? a.Institucion : (metadata?.Institucion ?? "Certificado académico");
    <section class="card card-pad stack" style="margin-bottom:14px">
        <div>
            <h2>@nombreInst</h2>
            <p class="page-sub">@a.Nombre · @Formato.Fecha(a.FechaRegistro)</p>
        </div>
        <div class="row-actions" style="justify-content:flex-start;flex-wrap:wrap">
            <ArchivoVista ArchivoId="a.Id" Mime="@a.Mime" Nombre="@a.Nombre" Sha256="@a.Sha256" />
            <button type="button" class="btn btn-ghost btn-sm" disabled="@ocupado" @onclick="() => Editar(a)">Modificar</button>
            <button type="button" class="btn btn-ghost btn-sm" disabled="@ocupado" @onclick="() => porEliminar = a">Eliminar</button>
        </div>
    </section>
}

<ConfirmDialog Abierto="@(porEliminar is not null)" Titulo="Eliminar certificado" Mensaje="Se dará de baja el certificado y su archivo." TextoConfirmar="Eliminar" OnCancelar="() => porEliminar = null" OnConfirmar="Eliminar" />

@code {
    private List<ArchivoDigitalDto> archivos = [];
    private ArchivoSeleccionado? seleccion;
    private ArchivoDigitalDto? porEliminar;
    private int editando;
    private string institucion = "";
    private string tipoInstitucion = "COLEGIO";
    private int inicio = 2020;
    private int fin = 2025;
    private DateOnly fecha;
    private bool ocupado;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        fecha = Datos.Hoy;
        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            archivos = await Api.ListarArchivosAsync(Datos.PostulanteActualId);
        }
        catch (Exception)
        {
            error = "No se pudieron cargar tus certificados.";
        }
    }

    private void Editar(ArchivoDigitalDto a)
    {
        var metadata = Datos.Antecedentes.FirstOrDefault(x => x.Id == a.ReferenciaId);
        editando = a.ReferenciaId;
        institucion = !string.IsNullOrWhiteSpace(a.Institucion) ? a.Institucion : (metadata?.Institucion ?? "");
        tipoInstitucion = string.IsNullOrWhiteSpace(a.TipoInstitucion) ? "COLEGIO" : a.TipoInstitucion;
        inicio = a.AnioInicio > 0 ? a.AnioInicio : (metadata?.AnioInicio > 0 ? metadata.AnioInicio : 2020);
        fin = a.AnioFin > 0 ? a.AnioFin : (metadata?.AnioFin > 0 ? metadata.AnioFin : 2025);
        fecha = a.FechaRegistro ?? Datos.Hoy;
        seleccion = null;
        error = null;
    }

    private void Cancelar()
    {
        editando = 0;
        institucion = "";
        tipoInstitucion = "COLEGIO";
        seleccion = null;
        fecha = Datos.Hoy;
        error = null;
    }

    private async Task Guardar()
    {
        if (ocupado || seleccion is null) return;
        if (string.IsNullOrWhiteSpace(institucion))
        {
            error = "Ingresa el nombre de la institución educativa.";
            return;
        }
        if (inicio > fin)
        {
            error = "El año de inicio no puede ser mayor que el año de finalización.";
            return;
        }
        ocupado = true;
        error = null;
        try
        {
            var f = seleccion;
            await Api.GuardarArchivoAsync(new()
            {
                PostulanteId = Datos.PostulanteActualId,
                Tipo = "CERTIFICADO",
                ReferenciaId = editando,
                Nombre = f.Nombre,
                Mime = f.Mime,
                ContenidoBase64 = f.ContenidoBase64,
                FechaRegistro = fecha,
                Institucion = institucion.Trim(),
                TipoInstitucion = tipoInstitucion,
                AnioInicio = inicio,
                AnioFin = fin
            }, "guardarCertificado");

            Cancelar();
            Avisos.Exito("Certificado y archivo guardados");

            try
            {
                await Datos.CargarDesdeBackendAsync();
            }
            catch (Exception)
            {
                // El certificado ya fue persistido; no enmascarar el éxito si la recarga auxiliar falla.
            }
            await Cargar();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            ocupado = false;
        }
    }

    private async Task Eliminar()
    {
        if (porEliminar is null || ocupado) return;
        var objetivo = porEliminar;
        ocupado = true;
        error = null;
        try
        {
            await Api.EliminarArchivoAsync(objetivo.Id);
            porEliminar = null;
            Avisos.Exito("Certificado eliminado");
            try
            {
                await Datos.CargarDesdeBackendAsync();
            }
            catch (Exception)
            {
            }
            await Cargar();
        }
        catch (Exception ex)
        {
            porEliminar = null;
            error = ex.Message;
        }
        finally
        {
            ocupado = false;
        }
    }
}
