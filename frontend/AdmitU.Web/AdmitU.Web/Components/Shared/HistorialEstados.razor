@if (Cambios.Count == 0)
{
    <EmptyState Icono="clock" Titulo="Sin cambios registrados" Mensaje="Los cambios de estado aparecerán aquí." />
}
else
{
    <div class="table-inline"><div class="table-scroll">
        <table class="table">
            <thead><tr><th>Fecha</th><th>De</th><th>A</th><th>Responsable</th><th>Motivo</th></tr></thead>
            <tbody>
                @foreach (var c in Cambios)
                {
                    <tr>
                        <td>@Formato.Fecha(c.Fecha)</td>
                        <td>@(c.Anterior ?? "—")</td>
                        <td><strong>@c.Actual</strong></td>
                        <td>@c.Responsable</td>
                        <td style="white-space:normal;min-width:220px">@c.Motivo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div></div>
}

@code {
    [Parameter, EditorRequired] public int PostulacionId { get; set; }

    private List<CambioEstado> Cambios => DatosDemo.Historial.Where(c => c.PostulacionId == PostulacionId).OrderByDescending(c => c.Fecha).ToList();
}
