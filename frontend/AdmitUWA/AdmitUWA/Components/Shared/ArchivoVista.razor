@using System.Net
@using AdmitUWA.Services.REST
@inject AdmitURestClient Api

<button type="button" class="btn btn-ghost btn-sm" disabled="@ocupado" @onclick="Mostrar">
    @(ocupado ? "Cargando…" : "Visualizar / descargar")
</button>
@if (error is not null)
{
    <p class="validation-message" role="alert">@error</p>
}
@if (uri is not null)
{
    <a class="btn btn-ghost btn-sm" href="@uri" download="@Nombre">Descargar @Nombre</a>
    @if (Mime.StartsWith("image/", StringComparison.OrdinalIgnoreCase))
    {
        <div style="margin-top:10px;padding:10px;border:1px solid var(--border);border-radius:10px;background:var(--surface-2);text-align:center">
            <img src="@uri" alt="Archivo @Nombre" style="max-width:100%;max-height:420px;object-fit:contain;border-radius:6px" />
        </div>
    }
    else
    {
        <iframe src="@uri" title="Archivo @Nombre" style="width:100%;height:420px;margin-top:10px;border:1px solid var(--border);border-radius:10px"></iframe>
    }
}

@code {
    [Parameter] public int ArchivoId { get; set; }
    [Parameter] public string Mime { get; set; } = "application/pdf";
    [Parameter] public string Nombre { get; set; } = "archivo";
    [Parameter] public string Sha256 { get; set; } = "";

    private bool ocupado;
    private string? uri;
    private string? error;
    private (int, string, string) ultimo;

    protected override void OnParametersSet()
    {
        var clave = (ArchivoId, Nombre, Sha256);
        if (ultimo != clave)
        {
            ultimo = clave;
            uri = null;
            error = null;
        }
    }

    private async Task Mostrar()
    {
        if (ocupado) return;
        ocupado = true;
        error = null;
        try
        {
            var bytes = await Api.DescargarArchivoAsync(ArchivoId);
            uri = "data:" + Mime + ";base64," + Convert.ToBase64String(bytes);
        }
        catch (HttpRequestException ex)
        {
            error = ex.StatusCode switch
            {
                HttpStatusCode.Unauthorized => "Tu sesión expiró. Vuelve a iniciar sesión para ver el archivo.",
                HttpStatusCode.Forbidden => "No cuentas con permisos para consultar este archivo.",
                HttpStatusCode.NotFound => "El archivo solicitado ya no está disponible en el expediente.",
                _ => "No se pudo recuperar el archivo desde el servidor. Inténtalo de nuevo."
            };
        }
        catch (Exception)
        {
            error = "No se pudo recuperar el archivo. Verifica tu conexión y permisos.";
        }
        finally
        {
            ocupado = false;
        }
    }
}
