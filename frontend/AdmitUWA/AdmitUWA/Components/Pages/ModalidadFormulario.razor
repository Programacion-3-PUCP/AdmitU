@page "/modalidades/nuevo"
@page "/modalidades/editar/{Id:int}"
@inject IAdmitUService Servicio
@inject NavigationManager Navegacion

<PageTitle>@(Id is > 0 ? "Modificar" : "Registrar") modalidad | AdmitU</PageTitle>
<div class="page-title">
    <div>
        <div class="breadcrumb-text">AdmitU / <a href="/modalidades">Modalidads</a> / @(Id is > 0 ? "Editar" : "Nuevo")</div>
        <h1>@(Id is > 0 ? "Modificar" : "Registrar") modalidad</h1>
        <p>Complete los campos correspondientes y guarde los cambios.</p>
    </div>
    <a href="/modalidades" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Volver al listado</a>
</div>

<Aviso Mensaje="@mensajeError" EsError="true" />

@if (cargando)
{
    <div class="panel-card p-4">Cargando información...</div>
}
else if (encontrado)
{
    <section class="panel-card">
        <div class="panel-head"><h2>Datos de modalidad</h2><span class="table-meta">* Campos obligatorios</span></div>
        <div class="panel-body">
            <EditForm Model="@modelo" OnValidSubmit="GuardarAsync" FormName="formModalidad">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small mb-3" />
                <div class="form-grid">

                <div>
                    <label class="form-label">Código de modalidad *</label>
                    <InputText @bind-Value="modelo.CodigoModalidad" class="form-control" placeholder="Ej. ORD" />
                    <ValidationMessage For="@(() => modelo.CodigoModalidad)" />
                </div>
                <div>
                    <label class="form-label">Nombre *</label>
                    <InputText @bind-Value="modelo.Nombre" class="form-control" placeholder="Ej. Evaluación ordinaria" />
                    <ValidationMessage For="@(() => modelo.Nombre)" />
                </div>
                <div class="full-span">
                    <label class="form-label">Descripción</label>
                    <InputTextArea @bind-Value="modelo.Descripcion" class="form-control" rows="3" />
                </div>
                <div class="full-span d-flex gap-4 flex-wrap">
                    <label class="form-check-label"><InputCheckbox @bind-Value="modelo.RequiereColegio" class="form-check-input me-2" />Requiere colegio</label>
                    <label class="form-check-label"><InputCheckbox @bind-Value="modelo.RequiereUniversidad" class="form-check-input me-2" />Requiere universidad</label>
                    <label class="form-check-label"><InputCheckbox @bind-Value="modelo.Activo" class="form-check-input me-2" />Modalidad activa</label>
                </div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Volver">Cancelar</button>
                    <button type="submit" disabled="@guardando" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>@(guardando ? "Guardando..." : "Guardar cambios")
                    </button>
                </div>
            </EditForm>
        </div>
    </section>
}

@code {
    [Parameter] public int? Id { get; set; }
    private ModalidadDto modelo = new();
    private bool encontrado = true;
    private bool cargando = true;
    private bool guardando;
    private string? mensajeError;
    

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        mensajeError = null;
        encontrado = true;
        try
        {
            
            if (Id is > 0)
            {
                var resultado = await Servicio.ObtenerModalidadAsync(Id.Value);
                if (resultado is null)
                {
                    encontrado = false;
                    mensajeError = "No se encontró el registro solicitado.";
                }
                else modelo = resultado;
            }
            else modelo = new ModalidadDto();
        }
        catch (Exception ex)
        {
            encontrado = false;
            mensajeError = $"No fue posible cargar el formulario: {ex.Message}";
        }
        finally { cargando = false; }
    }

    private void Volver() => Navegacion.NavigateTo("/modalidades");

    private async Task GuardarAsync()
    {
        if (guardando) return;
        guardando = true;
        mensajeError = null;
        try
        {
            await Servicio.GuardarModalidadAsync(modelo);
            Navegacion.NavigateTo("/modalidades");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar: {ex.Message}";
        }
        finally { guardando = false; }
    }
}
