@page "/admin/postulaciones/{Id:int}"
@inject DatosSesion Datos
@inject ToastService Avisos

@if (p is null)
{
    <RecursoNoEncontrado Titulo="Postulación no encontrada" Seccion="Postulaciones" Volver="/admin/postulaciones" />
}
else
{
    var persona = Datos.PersonaDe(p);
    var evaluador = Datos.Evaluador(p.EvaluadorId);
    var pago = Datos.PagoDe(p.Id);
    var carne = Datos.CarneVigenteDe(p.Id);
    <PageTitle>@p.Codigo · AdmitU</PageTitle>
    <PageHeader Titulo="@p.Codigo" Subtitulo="@($"{Datos.Carrera(p.CarreraId)?.Nombre} · {Datos.Modalidad(p.ModalidadId)?.Nombre} · {Datos.Convocatoria(p.ConvocatoriaId)?.Nombre}")"
                Migas="@(["Postulaciones", p.Codigo])" Enlaces="@(["/admin/postulaciones"])">
        <Acciones>
            <a class="btn btn-ghost" href="/admin/postulaciones?conv=@p.ConvocatoriaId"><Icon Name="arrow-left" Size="16" />Volver</a>
            @if (p.Estado.EsPendiente() || p.Estado == EstadoPostulacion.Enviada)
            {
                <button type="button" class="btn btn-primary" @onclick="AbrirAsignacion"><Icon Name="user-check" Size="16" />@(evaluador is null ? "Asignar evaluador" : "Reasignar evaluador")</button>
            }
        </Acciones>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(p.Observacion))
    {
        <div class="notice" style="margin-bottom:18px" role="status">
            <Icon Name="alert" Size="20" />
            <div><strong>@(p.Estado == EstadoPostulacion.NoApta ? "Expediente no apto" : "Expediente observado")</strong><p>@p.Observacion</p></div>
        </div>
    }

    <div class="detail-grid">
        <div class="stack">
            <section class="card card-pad">
                <div class="card-head"><h2>Progreso</h2><StatusBadge Texto="@p.Estado.Etiqueta()" Tono="@p.Estado.Tono()" /></div>
                <ProgresoPostulacion Postulacion="p" />
            </section>

            <section class="card card-pad">
                <div class="card-head"><h2>Documentos</h2><span class="muted">@documentos.Count(d => d.Estado == EstadoDocumento.Aprobado) de @documentos.Count aprobados</span></div>
                @if (documentos.Count == 0)
                {
                    <EmptyState Icono="folder" Titulo="Sin documentos" Mensaje="La postulación aún no se envía." />
                }
                else
                {
                    <ul class="list-rows">
                        @foreach (var d in documentos)
                        {
                            <li>
                                <span class="file-icon">@d.Tipo</span>
                                <div class="file-meta"><strong>@d.Requisito</strong><small>@d.Archivo · versión @d.Version · @Formato.Fecha(d.FechaCarga)@(d.Comentario is null ? "" : $" · {d.Comentario}")</small></div>
                                <StatusBadge Texto="@d.Estado.Etiqueta()" Tono="@d.Estado.Tono()" />
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="card card-pad">
                <div class="card-head"><div><h2>Historial de estados</h2><p>Se registra automáticamente con cada cambio.</p></div></div>
                <div class="table-scroll">
                    <table class="table">
                        <thead><tr><th>Fecha</th><th>Estado anterior</th><th>Estado nuevo</th><th>Responsable</th><th>Motivo</th></tr></thead>
                        <tbody>
                            @foreach (var m in Datos.HistorialDe(p.Id))
                            {
                                <tr>
                                    <td>@Formato.Fecha(m.Fecha)</td>
                                    <td>@(m.Anterior is { } a ? a.Etiqueta() : "—")</td>
                                    <td><StatusBadge Texto="@m.Nuevo.Etiqueta()" Tono="@m.Nuevo.Tono()" /></td>
                                    <td>@m.Responsable</td>
                                    <td class="wrap">@m.Motivo</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </section>
        </div>

        <aside class="stack">
            <section class="card card-pad">
                <div class="card-head"><h2>Postulante</h2></div>
                @if (persona is not null)
                {
                    <a class="cell-person" href="/admin/postulantes/@persona.Id">
                        <Avatar Nombre="@persona.NombreCompleto" />
                        <span><strong>@persona.NombreCompleto</strong><small>@persona.TipoDocumento @persona.NumeroDocumento</small></span>
                    </a>
                }
            </section>

            <section class="card card-pad">
                <div class="card-head"><h2>Evaluador</h2></div>
                @if (evaluador is null)
                {
                    <p class="muted">Aún no se asignó un evaluador.</p>
                }
                else
                {
                    <div class="cell-person"><Avatar Nombre="@evaluador.Nombre" /><span><strong>@evaluador.Nombre</strong><small>@evaluador.Especialidad</small></span></div>
                }
            </section>

            <section class="card card-pad">
                <div class="card-head"><h2>Pago de inscripción</h2></div>
                @if (pago is null)
                {
                    <p class="muted">Se genera al enviar la postulación.</p>
                }
                else
                {
                    <div class="summary-rows">
                        <div><span>Código</span><strong class="mono">@pago.Codigo</strong></div>
                        <div><span>Monto</span><strong>@Formato.Soles(pago.Monto)</strong></div>
                        <div><span>Estado</span><StatusBadge Texto="@pago.Estado.Etiqueta()" Tono="@pago.Estado.Tono()" /></div>
                        <div><span>Validado</span><strong>@Formato.Fecha(pago.FechaAprobacion)</strong></div>
                    </div>
                }
            </section>

            <section class="card card-pad">
                <div class="card-head"><h2>Carné</h2>@if (carne is not null) { <a class="link-more" href="/admin/carnes">Carnés<Icon Name="arrow-up-right" Size="14" /></a> }</div>
                @if (carne is null)
                {
                    <p class="muted">@(Datos.AptaSinCarne(p) ? "Apto sin carné: revisa la emisión en Carnés." : "Se emite automáticamente cuando el expediente es apto y el pago está validado.")</p>
                }
                else
                {
                    <div class="summary-rows">
                        <div><span>Código</span><strong class="mono">@carne.Codigo</strong></div>
                        <div><span>Sede</span><strong>@Datos.Sede(carne.SedeId)?.Nombre</strong></div>
                        <div><span>Aula</span><strong>@carne.Aula</strong></div>
                        <div><span>Emitido</span><strong>@Formato.Fecha(carne.FechaEmision)</strong></div>
                    </div>
                }
            </section>
        </aside>
    </div>

    <Drawer Abierto="asignando" Titulo="@(evaluador is null ? "Asignar evaluador" : "Reasignar evaluador")" Descripcion="El evaluador recibirá la postulación en su bandeja." OnCerrar="() => asignando = false">
        <form class="drawer-form" @onsubmit="Asignar" @onsubmit:preventDefault>
            <div class="drawer-body">
                <div class="field">
                    <label for="eva">Evaluador</label>
                    <select id="eva" @bind="elegido">
                        @foreach (var e in Datos.Evaluadores.Where(e => e.Activo))
                        {
                            var pendientes = Datos.Postulaciones.Count(x => x.EvaluadorId == e.Id && x.Estado.EsPendiente());
                            <option value="@e.Id">@e.Nombre · @e.Especialidad · @pendientes pendientes</option>
                        }
                    </select>
                    <span class="hint">Solo evaluadores activos, con su carga pendiente actual.</span>
                </div>
            </div>
            <div class="drawer-foot">
                <button type="button" class="btn btn-ghost" @onclick="() => asignando = false">Cancelar</button>
                <button type="submit" class="btn btn-primary"><Icon Name="check" Size="16" />Confirmar asignación</button>
            </div>
        </form>
    </Drawer>
}

@code {
    [Parameter] public int Id { get; set; }

    private Postulacion? p;
    private List<Documento> documentos = [];
    private bool asignando;
    private int elegido;

    protected override void OnParametersSet()
    {
        p = Datos.Postulacion(Id);
        if (p is not null) documentos = Datos.DocumentosDe(p.Id);
    }

    private void AbrirAsignacion()
    {
        elegido = p?.EvaluadorId ?? Datos.Evaluadores.FirstOrDefault(e => e.Activo)?.Id ?? 0;
        asignando = true;
    }

    private void Asignar()
    {
        if (p is null || Datos.Evaluador(elegido) is not { } e) return;
        Datos.AsignarEvaluador(p, e.Id);
        asignando = false;
        Avisos.Exito($"Postulación asignada a {e.Nombre}");
    }
}
