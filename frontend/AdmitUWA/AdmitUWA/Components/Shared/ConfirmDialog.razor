@if (Abierto)
{
    <div class="overlay" @onclick="Cancelar"></div>
    <div class="dialog" role="alertdialog" aria-modal="true" aria-label="@Titulo">
        <div class="dialog-icon tone-@Tono"><Icon Name="@(Tono == "danger" ? "alert" : "check-circle")" Size="22" /></div>
        <h2>@Titulo</h2>
        <p>@Mensaje</p>
        @if (ChildContent is not null)
        {
            <div class="dialog-body">@ChildContent</div>
        }
        @if (Error is not null)
        {
            <p class="validation-message" role="alert">@Error</p>
        }
        <div class="dialog-actions">
            <button type="button" class="btn btn-ghost" @onclick="Cancelar">Cancelar</button>
            <button type="button" class="btn @(Tono == "danger" ? "btn-danger" : "btn-primary")" @onclick="Confirmar">@TextoConfirmar</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Abierto { get; set; }
    [Parameter] public string Titulo { get; set; } = "¿Confirmar acción?";
    [Parameter] public string Mensaje { get; set; } = "";
    [Parameter] public string TextoConfirmar { get; set; } = "Confirmar";
    /// <summary>"danger" para acciones destructivas; "success" para confirmaciones positivas.</summary>
    [Parameter] public string Tono { get; set; } = "danger";
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirmar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private Task Confirmar() => OnConfirmar.InvokeAsync();
    private Task Cancelar() => OnCancelar.InvokeAsync();
}
