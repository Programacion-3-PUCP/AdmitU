<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ReporteObservados"
              pageWidth="842"
              pageHeight="595"
              orientation="Landscape"
              columnWidth="786"
              leftMargin="28"
              rightMargin="28"
              topMargin="24"
              bottomMargin="24"
              whenNoDataType="AllSectionsNoDetail">
    <style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>

    <subDataset name="ChartSerie1">
        <field name="serie" class="java.lang.String"/>
        <field name="etiqueta" class="java.lang.String"/>
        <field name="valor" class="java.lang.Number"/>
    </subDataset>
    <subDataset name="ChartSerie2">
        <field name="serie" class="java.lang.String"/>
        <field name="etiqueta" class="java.lang.String"/>
        <field name="valor" class="java.lang.Number"/>
    </subDataset>

    <parameter name="FILTROS" class="java.lang.String"/>
    <parameter name="CHART_SERIE_1" class="java.util.Collection" isForPrompting="false"/>
    <parameter name="CHART_SERIE_2" class="java.util.Collection" isForPrompting="false"/>

    <field name="convocatoria_id" class="java.lang.Long"/>
    <field name="convocatoria" class="java.lang.String"/>
    <field name="expediente" class="java.lang.String"/>
    <field name="postulante" class="java.lang.String"/>
    <field name="modalidad" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="descripcion" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>

    <group name="Convocatoria">
        <groupExpression><![CDATA[$F{convocatoria_id}]]></groupExpression>
        <groupHeader>
            <band height="24">
                <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                    <reportElement mode="Opaque" backcolor="#EEF2F8" x="0" y="2" width="786" height="20"/>
                    <textElement verticalAlignment="Middle">
                        <font size="9" isBold="true"/>
                    </textElement>
                    <textFieldExpression><![CDATA["  " + $F{convocatoria}]]></textFieldExpression>
                </textField>
            </band>
        </groupHeader>
    </group>

    <title>
        <band height="86">
            <staticText>
                <reportElement x="0" y="0" width="786" height="26" forecolor="#16325C"/>
                <textElement>
                    <font size="17" isBold="true"/>
                </textElement>
                <text><![CDATA[AdmitU | Expedientes con observaciones pendientes]]></text>
            </staticText>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="30" width="786" height="22"/>
                <textElement>
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{FILTROS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="0" y="55" width="786" height="24" forecolor="#526077"/>
                <textElement>
                    <font size="8"/>
                </textElement>
                <text><![CDATA[Cada fila corresponde a una observación documental en estado PENDIENTE de subsanación.]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="26">
            <staticText>
                <reportElement mode="Opaque" backcolor="#16325C" forecolor="#FFFFFF" x="0" y="0" width="105" height="24"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[  Expediente]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#16325C" forecolor="#FFFFFF" x="105" y="0" width="155" height="24"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Postulante]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#16325C" forecolor="#FFFFFF" x="260" y="0" width="125" height="24"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Modalidad]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#16325C" forecolor="#FFFFFF" x="385" y="0" width="75" height="24"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#16325C" forecolor="#FFFFFF" x="460" y="0" width="236" height="24"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Observación]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#16325C" forecolor="#FFFFFF" x="696" y="0" width="90" height="24"/>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="26">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="2" width="105" height="22"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{expediente}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="105" y="2" width="155" height="22"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{postulante}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="260" y="2" width="125" height="22"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{modalidad}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="385" y="2" width="75" height="22"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="460" y="2" width="236" height="22"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{descripcion}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="696" y="2" width="90" height="22"/>
                <textElement verticalAlignment="Top"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="0" width="150" height="18"/>
                <textElement><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="560" y="0" width="226" height="18"/>
                <textElement textAlignment="Right"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[java.time.ZonedDateTime.now(java.time.ZoneId.of("America/Lima")).format(java.time.format.DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm"))]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="245">
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="0" y="4" width="786" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Observaciones pendientes: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>

            <barChart>
                <chart isShowLegend="false" evaluationTime="Report">
                    <reportElement x="0" y="36" width="385" height="200" isRemoveLineWhenBlank="true">
                        <printWhenExpression><![CDATA[$P{CHART_SERIE_1} != null && !$P{CHART_SERIE_1}.isEmpty()]]></printWhenExpression>
                    </reportElement>
                    <chartTitle>
                        <font size="10" isBold="true"/>
                        <titleExpression><![CDATA["Observaciones pendientes por modalidad"]]></titleExpression>
                    </chartTitle>
                    <chartSubtitle/>
                    <chartLegend position="Bottom"/>
                </chart>
                <categoryDataset>
                    <dataset>
                        <datasetRun subDataset="ChartSerie1">
                            <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($P{CHART_SERIE_1})]]></dataSourceExpression>
                        </datasetRun>
                    </dataset>
                    <categorySeries>
                        <seriesExpression><![CDATA[$F{serie}]]></seriesExpression>
                        <categoryExpression><![CDATA[$F{etiqueta}]]></categoryExpression>
                        <valueExpression><![CDATA[$F{valor}]]></valueExpression>
                    </categorySeries>
                </categoryDataset>
                <barPlot isShowLabels="true" isShowTickLabels="true" isShowTickMarks="true">
                    <plot labelRotation="-20.0"/>
                    <itemLabel>
                        <font size="7"/>
                    </itemLabel>
                    <categoryAxisFormat labelRotation="-20.0">
                        <axisFormat>
                            <tickLabelFont>
                                <font size="7"/>
                            </tickLabelFont>
                        </axisFormat>
                    </categoryAxisFormat>
                    <valueAxisFormat>
                        <axisFormat>
                            <tickLabelFont>
                                <font size="8"/>
                            </tickLabelFont>
                        </axisFormat>
                    </valueAxisFormat>
                </barPlot>
            </barChart>

            <pieChart>
                <chart isShowLegend="true" evaluationTime="Report">
                    <reportElement x="401" y="36" width="385" height="200" isRemoveLineWhenBlank="true">
                        <printWhenExpression><![CDATA[$P{CHART_SERIE_2} != null && !$P{CHART_SERIE_2}.isEmpty()]]></printWhenExpression>
                    </reportElement>
                    <chartTitle>
                        <font size="10" isBold="true"/>
                        <titleExpression><![CDATA["Distribución por tipo de observación"]]></titleExpression>
                    </chartTitle>
                    <chartSubtitle/>
                    <chartLegend position="Bottom">
                        <font size="8"/>
                    </chartLegend>
                </chart>
                <pieDataset>
                    <dataset>
                        <datasetRun subDataset="ChartSerie2">
                            <dataSourceExpression><![CDATA[new net.sf.jasperreports.engine.data.JRMapCollectionDataSource($P{CHART_SERIE_2})]]></dataSourceExpression>
                        </datasetRun>
                    </dataset>
                    <keyExpression><![CDATA[$F{etiqueta}]]></keyExpression>
                    <valueExpression><![CDATA[$F{valor}]]></valueExpression>
                </pieDataset>
                <piePlot isShowLabels="true" labelFormat="{0}: {1} ({2})">
                    <plot/>
                    <itemLabel>
                        <font size="7"/>
                    </itemLabel>
                </piePlot>
            </pieChart>
        </band>
    </summary>
</jasperReport>
