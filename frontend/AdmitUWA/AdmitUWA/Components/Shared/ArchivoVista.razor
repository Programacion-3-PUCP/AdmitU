@using AdmitUWA.Services.REST
@inject AdmitURestClient Api
<button type="button" class="btn btn-ghost btn-sm" disabled="@ocupado" @onclick="Mostrar">Visualizar / descargar</button>
@if(error is not null){<p class="validation-message" role="alert">@error</p>}
@if(uri is not null){<a class="btn btn-ghost btn-sm" href="@uri" download="@Nombre">Descargar @Nombre</a><iframe src="@uri" title="Archivo @Nombre" style="width:100%;height:420px;border:1px solid #ddd"></iframe>}
@code {
 [Parameter] public int ArchivoId {get;set;}[Parameter] public string Mime {get;set;}="application/pdf";[Parameter] public string Nombre {get;set;}="archivo";
 private bool ocupado;private string? uri,error;
 protected override void OnParametersSet(){if(ultimo!=ArchivoId){ultimo=ArchivoId;uri=null;}}private int ultimo;
 private async Task Mostrar(){if(ocupado)return;ocupado=true;error=null;try{var bytes=await Api.DescargarArchivoAsync(ArchivoId);uri="data:"+Mime+";base64,"+Convert.ToBase64String(bytes);}catch(Exception){error="No se pudo recuperar el archivo. Verifica tu sesión y permisos.";}finally{ocupado=false;}}
}
