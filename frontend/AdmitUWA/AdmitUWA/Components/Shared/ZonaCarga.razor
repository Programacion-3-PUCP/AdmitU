@* Selector de archivo único: valida formato y tamaño antes de aceptarlo. El servidor validará el contenido real. *@
<div class="dropzone @(archivo is null ? "" : "has-file") @(error is null ? "" : "has-error") @(Deshabilitado ? "is-disabled" : "")">
    <label>
        <InputFile OnChange="Elegido" accept="@Formato.Extensiones()" class="dropzone-input" disabled="@Deshabilitado" />
        <span class="dropzone-icon"><Icon Name="@(archivo is null ? "upload" : "check-circle")" Size="20" /></span>
        <span class="dropzone-text">
            @if (archivo is null)
            {
                <strong>@Etiqueta</strong>
                <small>Haz clic para elegir el archivo · @Formato.Etiqueta() hasta @MaximoMb MB</small>
            }
            else
            {
                <strong>@archivo</strong>
                <small>Archivo listo · haz clic para cambiarlo</small>
            }
        </span>
    </label>
    @if (error is not null)
    {
        <p class="validation-message" role="alert">@error</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = "";
    [Parameter] public FormatoArchivo Formato { get; set; } = FormatoArchivo.Cualquiera;
    [Parameter] public int MaximoMb { get; set; } = 5;
    [Parameter] public bool Deshabilitado { get; set; }
    [Parameter] public string? Valor { get; set; }
    [Parameter] public EventCallback<string?> OnArchivo { get; set; }
    [Parameter] public EventCallback<ArchivoSeleccionado?> OnContenido { get; set; }
    private string? archivo,error,ultimoValor;
    protected override void OnParametersSet(){if(Valor!=ultimoValor){ultimoValor=Valor;archivo=Valor;error=null;}}
    private async Task Elegido(InputFileChangeEventArgs e)
    {
        var f=e.File;var extension=Path.GetExtension(f.Name).ToLowerInvariant();
        ArchivoSeleccionado? contenido=null;
        if(!Formato.Extensiones().Split(',').Contains(extension)){archivo=null;error=$"El archivo debe ser {Formato.Etiqueta()}.";}
        else if(f.Size<=0||f.Size>MaximoMb*1024L*1024L){archivo=null;error=$"El archivo debe medir entre 1 byte y {MaximoMb} MB.";}
        else
        {
            try {
                await using var stream=f.OpenReadStream(MaximoMb*1024L*1024L);
                using var memory=new MemoryStream();await stream.CopyToAsync(memory);
                var mime=extension switch {".png"=>"image/png",".jpg" or ".jpeg"=>"image/jpeg",".pdf"=>"application/pdf",_=>f.ContentType};
                contenido=new ArchivoSeleccionado {Nombre=f.Name,Mime=mime,Bytes=memory.ToArray()};archivo=f.Name;error=null;
            }catch(Exception){archivo=null;error="No se pudo leer el archivo o supera el tamaño permitido.";}
        }
        ultimoValor=archivo;await OnArchivo.InvokeAsync(archivo);await OnContenido.InvokeAsync(contenido);
    }
}
