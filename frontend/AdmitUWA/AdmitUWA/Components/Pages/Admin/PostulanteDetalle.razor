@page "/admin/postulantes/{Id:int}"
@inject DatosSesion Datos
@inject ToastService Avisos

@if (persona is null)
{
    <RecursoNoEncontrado Titulo="Postulante no encontrado" Seccion="Postulantes" Volver="/admin/postulantes" />
}
else
{
    <PageTitle>@persona.NombreCompleto · AdmitU</PageTitle>
    <PageHeader Titulo="Ficha del postulante" Subtitulo="Datos registrados por el propio postulante. Solo lectura." Migas="@(["Postulantes", persona.NombreCompleto])" Enlaces="@(["/admin/postulantes"])">
        <Acciones>
            <a class="btn btn-ghost" href="/admin/postulantes"><Icon Name="arrow-left" Size="16" />Volver</a>
        </Acciones>
    </PageHeader>

    <div class="detail-grid">
        <div class="stack">
            <section class="card card-pad">
                <div class="profile">
                    <Avatar Nombre="@persona.NombreCompleto" Tamano="lg" />
                    <div>
                        <h2>@persona.NombreCompleto</h2>
                        <div class="feed-tags">
                            <StatusBadge Texto="@(persona.CorreoValidado ? "Correo validado" : "Correo sin validar")" Tono="@(persona.CorreoValidado ? "success" : "warning")" />
                            @if (persona.TieneDiscapacidad) { <StatusBadge Texto="Requiere ajustes razonables" Tono="violet" /> }
                        </div>
                    </div>
                </div>
                <hr class="divider" />
                <dl class="dl">
                    <div><dt>Documento</dt><dd>@persona.TipoDocumento @persona.NumeroDocumento</dd></div>
                    <div><dt>Fecha de nacimiento</dt><dd>@Formato.Fecha(persona.FechaNacimiento)</dd></div>
                    <div><dt>Correo electrónico</dt><dd>@persona.Correo</dd></div>
                    <div><dt>Teléfono</dt><dd>@(persona.Telefono ?? "No registrado")</dd></div>
                    @if (persona.TieneDiscapacidad)
                    {
                        <div><dt>Carné CONADIS</dt><dd>@persona.CarnetConadis</dd></div>
                    }
                </dl>
            </section>

            <section class="card card-pad">
                <div class="card-head"><h2>Postulaciones</h2></div>
                @if (postulaciones.Count == 0)
                {
                    <EmptyState Icono="file-text" Titulo="Aún no postula" Mensaje="Este postulante todavía no registra ninguna postulación." />
                }
                else
                {
                    <ul class="list-rows">
                        @foreach (var p in postulaciones)
                        {
                            <li>
                                <span class="feed-icon"><Icon Name="file-text" Size="18" /></span>
                                <div class="file-meta">
                                    <strong><a href="/admin/postulaciones/@p.Id">@p.Codigo</a> · @Datos.Convocatoria(p.ConvocatoriaId)?.Nombre</strong>
                                    <small>@Datos.Carrera(p.CarreraId)?.Nombre · @Datos.Modalidad(p.ModalidadId)?.Nombre</small>
                                </div>
                                <StatusBadge Texto="@p.Estado.Etiqueta()" Tono="@p.Estado.Tono()" />
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>

        <aside class="stack">
            <section class="card card-pad">
                <div class="card-head"><h2>Comunicación</h2></div>
                @if (persona.CorreoValidado)
                {
                    <p class="muted">El correo ya fue validado.</p>
                }
                else
                {
                    <p class="hint" style="margin-bottom:12px">El postulante aún no confirma su correo; no recibirá avisos por ese medio.</p>
                    <button type="button" class="btn btn-ghost" @onclick='() => Avisos.Info("Simulación: el envío de correos se habilitará al integrar el backend.")'><Icon Name="mail" Size="16" />Reenviar validación de correo</button>
                }
            </section>
        </aside>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private Postulante? persona;
    private List<Postulacion> postulaciones = [];

    protected override void OnParametersSet()
    {
        persona = Datos.Postulante(Id);
        postulaciones = Datos.Postulaciones.Where(p => p.PostulanteId == Id).OrderByDescending(p => p.FechaRegistro).ToList();
    }
}
