@page "/error"
@layout AdmitUWA.Components.Layout.AccesoLayout

<PageTitle>Error · AdmitU</PageTitle>

<main class="registro">
    <h1 class="sr-only">Ocurrió un error</h1>
    <section class="card" style="margin-top:40px">
        <EmptyState Icono="alert" Titulo="Algo salió mal" Mensaje="Ocurrió un error inesperado. Intenta nuevamente en unos instantes.">
