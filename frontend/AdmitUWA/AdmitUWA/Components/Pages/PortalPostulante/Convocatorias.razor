@page "/postulante/convocatorias"
@inject DatosSesion Datos

<PageTitle>Convocatorias · AdmitU</PageTitle>

<PageHeader Titulo="Convocatorias" Subtitulo="Procesos de admisión con inscripciones abiertas y finalizados." Migas="@(["Convocatorias"])" />

<div class="conv-grid">
    @foreach (var c in Datos.Convocatorias.Where(c => c.Estado != EstadoConvocatoria.Borrador).OrderByDescending(c => c.Inicio))
    {
        bool abierta = Datos.InscripcionesAbiertas(c);
        var ofertas = Datos.Ofertas.Where(o => o.ConvocatoriaId == c.Id).ToList();
        <article class="card conv">
            <div class="conv-top">
                <div><span class="code">@c.Periodo</span><h2 class="conv-title">@c.Nombre</h2></div>
                <StatusBadge Texto="@(abierta ? "Inscripciones abiertas" : "Finalizada")" Tono="@(abierta ? "success" : "neutral")" />
            </div>
            <p>@c.Descripcion</p>
            <div class="summary-rows">
                <div><span>Inscripciones</span><strong>@Formato.Fecha(c.Inicio) – @Formato.Fecha(c.CierreInscripciones)</strong></div>
                @foreach (var m in Datos.ModalidadesParaConvocatoria(c.Id))
                {
                    <div><span>@m.Nombre</span><strong>@Datos.TarifaInscripcionTexto(c.Id, m.Id)</strong></div>
                }
                <div><span>Oferta</span><strong>@ofertas.Count carreras · @ofertas.Sum(o => o.Vacantes) vacantes</strong></div>
            </div>
            <div class="conv-foot">
                <span>@(abierta ? (c.Fin is { } fin ? $"Cierra en {Math.Max(0, fin.DayNumber - Datos.Hoy.DayNumber)} días" : "Cierre no registrado") : "Fuera del periodo de inscripción")</span>
                @if (abierta)
                {
                    <a class="btn btn-primary btn-sm" href="/postulante/postular/@c.Id">Postular<Icon Name="arrow-right" Size="14" /></a>
                }
            </div>
        </article>
    }
</div>

<section class="card card-pad" style="margin-top:22px">
    <div class="card-head"><div><h2>Modalidades de ingreso</h2><p>Elige la vía que corresponde a tu situación.</p></div></div>
    <div class="grid-eq" style="margin-top:0">
        @foreach (var m in Datos.Modalidades.Where(m => m.Activo))
        {
            <div class="quick-item"><span class="q-icon"><Icon Name="list-checks" Size="18" /></span><div><strong>@m.Nombre</strong><small>@m.Descripcion Consulta la tarifa en cada convocatoria.</small></div></div>
        }
    </div>
</section>
