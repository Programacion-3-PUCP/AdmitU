@page "/admin/notificaciones"
@inject ToastService Avisos

<PageTitle>Notificaciones · AdmitU</PageTitle>

<PageHeader Titulo="Notificaciones" Subtitulo="Avisos del sistema y mensajes enviados a postulantes." Migas="@(["Notificaciones"])">
    <Acciones><button type="button" class="btn btn-ghost" @onclick='() => Avisos.Exito("Notificaciones marcadas como leídas")'><Icon Name="check" Size="16" />Marcar todo como leído</button></Acciones>
</PageHeader>

<NotificacionesPanel Items="@DatosDemo.Notificaciones.Where(n => n.Rol == "Administrador").ToList()" />
