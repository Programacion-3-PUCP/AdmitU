@page "/facultades/nuevo"
@page "/facultades/editar/{Id:int}"
@inject IAdmitUService Servicio
@inject NavigationManager Navegacion

<PageTitle>@(Id is > 0 ? "Modificar" : "Registrar") facultad | AdmitU</PageTitle>
<div class="page-title">
    <div>
        <div class="breadcrumb-text">AdmitU / <a href="/facultades">Facultades</a> / @(Id is > 0 ? "Editar" : "Nuevo")</div>
        <h1>@(Id is > 0 ? "Modificar" : "Registrar") facultad</h1>
        <p>Complete los campos correspondientes y guarde los cambios.</p>
    </div>
    <a href="/facultades" class="btn btn-outline-secondary"><i class="fa-solid fa-arrow-left me-2"></i>Volver al listado</a>
</div>

<Aviso Mensaje="@mensajeError" EsError="true" />

@if (cargando)
{
    <div class="panel-card p-4">Cargando información...</div>
}
else if (encontrado)
{
    <section class="panel-card">
        <div class="panel-head"><h2>Datos de facultad</h2><span class="table-meta">* Campos obligatorios</span></div>
        <div class="panel-body">
            <EditForm Model="@modelo" OnValidSubmit="GuardarAsync" FormName="formFacultad">
                <DataAnnotationsValidator />
                <ValidationSummary class="text-danger small mb-3" />
                <div class="form-grid">

                <div>
                    <label class="form-label">Código de facultad *</label>
                    <InputText @bind-Value="modelo.Codigo" class="form-control" placeholder="Ej. ING" />
                    <ValidationMessage For="@(() => modelo.Codigo)" />
                </div>
                <div>
                    <label class="form-label">Nombre *</label>
                    <InputText @bind-Value="modelo.Nombre" class="form-control" placeholder="Ej. Ingeniería" />
                    <ValidationMessage For="@(() => modelo.Nombre)" />
                </div>
                <div class="full-span"><label class="form-check-label"><InputCheckbox @bind-Value="modelo.Activo" class="form-check-input me-2" />Facultad activa</label></div>
                </div>
                <div class="form-actions">
                    <button type="button" class="btn btn-outline-secondary" @onclick="Volver">Cancelar</button>
                    <button type="submit" disabled="@guardando" class="btn btn-primary">
                        <i class="fa-solid fa-floppy-disk me-2"></i>@(guardando ? "Guardando..." : "Guardar cambios")
                    </button>
                </div>
            </EditForm>
        </div>
    </section>
}

@code {
    [Parameter] public int? Id { get; set; }
    private FacultadDto modelo = new();
    private bool encontrado = true;
    private bool cargando = true;
    private bool guardando;
    private string? mensajeError;
    

    protected override async Task OnParametersSetAsync()
    {
        cargando = true;
        mensajeError = null;
        encontrado = true;
        try
        {
            
            if (Id is > 0)
            {
                var resultado = await Servicio.ObtenerFacultadAsync(Id.Value);
                if (resultado is null)
                {
                    encontrado = false;
                    mensajeError = "No se encontró el registro solicitado.";
                }
                else modelo = resultado;
            }
            else modelo = new FacultadDto();
        }
        catch (Exception ex)
        {
            encontrado = false;
            mensajeError = $"No fue posible cargar el formulario: {ex.Message}";
        }
        finally { cargando = false; }
    }

    private void Volver() => Navegacion.NavigateTo("/facultades");

    private async Task GuardarAsync()
    {
        if (guardando) return;
        guardando = true;
        mensajeError = null;
        try
        {
            await Servicio.GuardarFacultadAsync(modelo);
            Navegacion.NavigateTo("/facultades");
        }
        catch (Exception ex)
        {
            mensajeError = $"No se pudo guardar: {ex.Message}";
        }
        finally { guardando = false; }
    }
}
