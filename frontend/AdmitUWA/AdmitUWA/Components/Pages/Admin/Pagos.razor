@page "/admin/pagos"
@inject DatosSesion Datos
@inject NavigationManager Navegacion

<PageTitle>Pagos · AdmitU</PageTitle>

<PageHeader Titulo="Pagos de inscripción" Subtitulo="Derecho de inscripción de cada postulación. Los vouchers los valida el evaluador." Migas="@(["Pagos"])" />

<section class="kpis kpis-3">
    <StatCard Etiqueta="Recaudado" Valor="@Formato.Soles(Total(EstadoPago.Aprobado))" Detalle="@($"{Contar(EstadoPago.Aprobado)} pagos validados")" Icono="wallet" Tono="success" />
    <StatCard Etiqueta="Por validar" Valor="@Formato.Soles(Total(EstadoPago.Pendiente))" Detalle="@($"{Contar(EstadoPago.Pendiente)} vouchers en revisión")" Icono="clock" Tono="warning" />
    <StatCard Etiqueta="Sin voucher o rechazados" Valor="@((Contar(EstadoPago.Generado) + Contar(EstadoPago.Rechazado)).ToString())" Detalle="El postulante debe adjuntar un voucher" Icono="alert" Tono="danger" />
</section>

<div class="chips" role="group" aria-label="Filtrar por estado">
    <button type="button" class="chip @(Estado is null ? "is-active" : "")" @onclick='() => Ir(estado: "")'>Todos<em>@pagos.Count</em></button>
    @foreach (var e in Enum.GetValues<EstadoPago>().Where(e => pagos.Any(x => x.Estado == e)))
    {
        var actual = e;
        <button type="button" class="chip @(Estado == actual.ToString() ? "is-active" : "")" @onclick="() => Ir(estado: actual.ToString())">@actual.Etiqueta()<em>@Contar(actual)</em></button>
    }
</div>

<DataTable TItem="Pago" Items="@pagos.Where(x => string.IsNullOrEmpty(Estado) || x.Estado.ToString() == Estado)" TextoBusqueda="@(x => $"{x.Codigo} {Datos.PersonaDePostulacion(x.PostulacionId)?.NombreCompleto} {Datos.Postulacion(x.PostulacionId)?.Codigo}")" Marcador="Buscar por código de pago, postulante o postulación">
    <Filtros>
        <select class="select" aria-label="Convocatoria" value="@convId" @onchange='e => Ir(conv: int.Parse(e.Value!.ToString()!))'>
            @foreach (var c in Datos.Convocatorias.OrderByDescending(c => c.Inicio)) { <option value="@c.Id">@c.Nombre</option> }
        </select>
    </Filtros>
    <Encabezado>
        <th>Código</th><th>Postulante</th><th class="num">Monto</th><th>Generado</th><th>Último voucher</th><th>Estado</th><th class="th-actions">Acciones</th>
    </Encabezado>
    <Fila Context="x">
        @{ var persona = Datos.PersonaDePostulacion(x.PostulacionId); var voucher = Datos.VouchersDe(x.PostulacionId).FirstOrDefault(); }
        <tr>
            <td><span class="mono">@x.Codigo</span></td>
            <td><span class="cell-title">@persona?.NombreCompleto</span><span class="cell-sub">@Datos.Postulacion(x.PostulacionId)?.Codigo</span></td>
            <td class="num">@Formato.Soles(x.Monto)</td>
            <td>@Formato.Fecha(x.FechaGeneracion)</td>
            <td>@(voucher is null ? "—" : $"{voucher.CodigoOperacion} · {Formato.Fecha(voucher.FechaRegistro)}")</td>
            <td><StatusBadge Texto="@x.Estado.Etiqueta()" Tono="@x.Estado.Tono()" /></td>
            <td class="td-actions"><span class="row-actions"><BotonAccion Tipo="BotonAccion.Accion.Ver" Texto="Ver postulación" Sobre="@x.Codigo" Href="@($"/admin/postulaciones/{x.PostulacionId}")" /></span></td>
        </tr>
    </Fila>
</DataTable>

@code {
    [SupplyParameterFromQuery(Name = "conv")] public int? Conv { get; set; }
    [SupplyParameterFromQuery(Name = "estado")] public string? Estado { get; set; }

    private int convId;
    private List<Pago> pagos = [];

    protected override void OnParametersSet()
    {
        convId = Conv ?? Datos.ConvocatoriaPorDefecto;
        var ids = Datos.PostulacionesDeConvocatoria(convId).Select(p => p.Id).ToHashSet();
        pagos = Datos.Pagos.Where(p => ids.Contains(p.PostulacionId)).OrderByDescending(p => p.FechaGeneracion).ToList();
    }

    private decimal Total(EstadoPago e) => pagos.Where(x => x.Estado == e).Sum(x => x.Monto);
    private int Contar(EstadoPago e) => pagos.Count(x => x.Estado == e);

    private void Ir(int? conv = null, string? estado = null) =>
        Navegacion.NavigateTo(Navegacion.GetUriWithQueryParameters(new Dictionary<string, object?>
        {
            ["conv"] = conv ?? convId,
            ["estado"] = estado is null ? Estado : estado == "" ? null : estado
        }));
}
