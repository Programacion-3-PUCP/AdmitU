@if (Abierto)
{
    <div class="overlay" disabled="@ocupado" @onclick="Cancelar"></div>
    <div class="dialog" role="alertdialog" aria-modal="true" aria-label="@Titulo">
        <div class="dialog-icon tone-@Tono"><Icon Name="@(Tono == "danger" ? "alert" : "check-circle")" Size="22" /></div>
        <h2>@Titulo</h2>
        <p>@Mensaje</p>
        @if (ChildContent is not null)
        {
            <div class="dialog-body">@ChildContent</div>
        }
        @if (Error is not null || errorInterno is not null)
        {
            <p class="validation-message" role="alert">@(Error ?? errorInterno)</p>
        }
        <div class="dialog-actions">
            <button type="button" class="btn btn-ghost" disabled="@ocupado" @onclick="Cancelar">Cancelar</button>
            <button type="button" class="btn @(Tono == "danger" ? "btn-danger" : "btn-primary")" disabled="@ocupado" @onclick="Confirmar">@(ocupado ? "Procesando…" : TextoConfirmar)</button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Abierto { get; set; }
    [Parameter] public string Titulo { get; set; } = "¿Confirmar acción?";
    [Parameter] public string Mensaje { get; set; } = "";
    [Parameter] public string TextoConfirmar { get; set; } = "Confirmar";
    /// <summary>"danger" para acciones destructivas; "success" para confirmaciones positivas.</summary>
    [Parameter] public string Tono { get; set; } = "danger";
    [Parameter] public string? Error { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnConfirmar { get; set; }
    [Parameter] public EventCallback OnCancelar { get; set; }

    private bool ocupado;
    private string? errorInterno;
    private async Task Confirmar()
    {
        if (ocupado) return;
        ocupado = true; errorInterno = null;
        try { await OnConfirmar.InvokeAsync(); }
        catch { errorInterno = "No se pudo completar la operación. Revisa los datos e inténtalo de nuevo."; }
        finally { ocupado = false; }
    }
    private Task Cancelar() { errorInterno = null; return ocupado ? Task.CompletedTask : OnCancelar.InvokeAsync(); }
}
