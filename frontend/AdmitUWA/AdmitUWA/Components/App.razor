<!DOCTYPE html>
<html lang="es" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#16325c" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/areas.css" />
    <script src="js/app.js"></script>
    <HeadOutlet @rendermode="ModoPagina" />
</head>
<body>
    <Routes @rendermode="ModoPagina" />
    <div id="blazor-error-ui" role="alert">
        Se perdió la conexión con el servidor o ocurrió un error.
        <a href="" class="reload">Recargar la página</a>
        <button type="button" class="dismiss" aria-label="Cerrar">✕</button>
    </div>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [CascadingParameter] private HttpContext Contexto { get; set; } = default!;
    private IComponentRenderMode? ModoPagina => Contexto.AcceptsInteractiveRouting() ? InteractiveServer : null;
}
