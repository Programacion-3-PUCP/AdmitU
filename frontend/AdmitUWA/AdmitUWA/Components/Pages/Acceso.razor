@page "/"
@layout AdmitUWA.Components.Layout.AccesoLayout
@inject DatosSesion Datos
<PageTitle>Ingresar · AdmitU</PageTitle>
<div class="login">
 <section class="login-brand"><a class="brand" href="/"><Logo/><span class="brand-text"><strong>Admit<em>U</em></strong><small>Admisión universitaria</small></span></a>
 <div class="login-copy"><h2>Tu admisión, paso a paso.</h2><p>Postula, presenta tus documentos y consulta el avance de tu expediente.</p></div>
 @if(Datos.ConvocatoriaVigente is {} conv){<div class="login-conv"><span class="eyebrow">Convocatoria vigente</span><h3>@conv.Nombre</h3></div>}
 </section>
 <section class="login-panel"><div class="login-card"><h1>Ingresar</h1><p class="page-sub">Usa el correo y contraseña de tu cuenta.</p>
 @if(Datos.ErrorCarga is not null){<p class="notice" role="alert">@Datos.ErrorCarga</p>}
 @if(Error is not null){<p class="validation-message" role="alert">@(Error=="servicio"?"No fue posible conectar con el servicio. Intenta nuevamente.":"Credenciales incorrectas o cuenta temporalmente bloqueada.")</p>}
 <form method="post" action="/cuenta/ingresar" class="stack" data-enhance="false" style="gap:16px;margin-top:20px">
  <AntiforgeryToken/>
  <div class="field"><label for="correo">Correo electrónico</label><input id="correo" name="correo" type="email" required autocomplete="username" maxlength="150" /></div>
  <div class="field"><label for="clave">Contraseña</label><input id="clave" name="clave" type="password" required autocomplete="current-password" maxlength="128" /></div>
  <button type="submit" class="btn btn-primary">Ingresar<Icon Name="arrow-right" Size="16"/></button>
 </form><div class="login-register"><div><strong>¿Postulas por primera vez?</strong><small>Crea tu cuenta para iniciar tu postulación.</small></div><a class="btn btn-ghost" href="/registro">Crear cuenta</a></div>
 </div></section>
</div>
@code {
 [SupplyParameterFromQuery(Name="error")] public string? Error {get;set;}
 protected override Task OnInitializedAsync() => Datos.InicializarAsync();
}
